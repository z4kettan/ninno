{
  "name": "web-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/ui/src",
  "prefix": "nn",
  "projectType": "library",
  "tags": ["scope:web", "type:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "libs/web/ui",
        "parallel": false,
        "commands": ["tsc -p tsconfig.lib.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"]
      }
    }
  }
}
