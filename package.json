  "private": true,
  "scripts": {
    "dev": "nx run-many -t serve -p api web --outputStyle=stream",
    "infra:up": "docker compose up -d --wait postgres redis s3 mailpit && docker compose run --rm s3-init",
    "infra:down": "docker compose down",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "e2e": "nx run-many -t e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "packageManager": "pnpm@12.8.1",
