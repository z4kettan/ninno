# Copy to .env for local development. Never commit .env.
# The API validates these at startup and refuses to boot if a required one is missing.

NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
# Comma-separated list of origins allowed by CORS.
WEB_ORIGINS=http://localhost:4300
# Max JSON body size accepted by the API.
BODY_LIMIT=100kb
# Global rate limit per client IP.
RATE_LIMIT_PER_MINUTE=100

# Matches docker-compose.yml
DATABASE_URL=postgresql://ninno:ninno@localhost:5433/ninno?schema=public
# Admin connection for `nx run api:test-db`: each run creates and drops its own ninno_test_<ts>_<pid> database.
DATABASE_URL_TEST=postgresql://ninno:ninno@localhost:5433/ninno_test?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=ninno-private
S3_ACCESS_KEY_ID=ninno
S3_SECRET_ACCESS_KEY=ninno-dev-secret

SMTP_URL=smtp://localhost:1025
