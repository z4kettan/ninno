# Copy to .env for local development. Never commit .env.
# The API validates these at startup and refuses to boot if a required one is missing.

NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
# Comma-separated list of origins allowed by CORS.
WEB_ORIGINS=http://localhost:4300
# Public address of the web app, used in QR join links. Defaults to the first WEB_ORIGINS entry.
# To test the QR with a real phone on your Wi-Fi, set it to http://<your-PC-LAN-IP>:4300.
APP_URL=
# Max JSON body size accepted by the API.
BODY_LIMIT=100kb
# Global rate limit per client IP.
RATE_LIMIT_PER_MINUTE=100

# Matches docker-compose.yml
DATABASE_URL=postgresql://ninno:ninno@localhost:5433/ninno?schema=public
# Admin connection for `nx run api:test-db`: each run creates and drops its own ninno_test_<ts>_<pid> database.
DATABASE_URL_TEST=postgresql://ninno:ninno@localhost:5433/ninno_test?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=ninno-private
S3_ACCESS_KEY_ID=ninno
S3_SECRET_ACCESS_KEY=ninno-dev-secret
# Where phones reach storage for signed upload/view URLs, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

SMTP_URL=smtp://localhost:1025

# --- Auth (phone + OTP) ---
# At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-000000
OTP_PEPPER=change-me-dev-only-otp-pepper-0000000000
# console = print codes to the API log (dev/test only). apitxt = real SMS; required in production.
OTP_SENDER=console
# From the apitxt dashboard (API Keys). Never commit a real key.
APITXT_AUTH_KEY=
# sms | whatsapp | voice
APITXT_CHANNEL=sms
# Optional: your DLT-approved SMS template id from the apitxt dashboard (needed for production SMS).
APITXT_TEMPLATE_ID=
# Log in locally as yourself: your number becomes the seeded owner (then run `pnpm db:seed`).
SEED_OWNER_PHONE=
